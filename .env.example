# Local synthetic development only. Replace this placeholder before starting Compose.
POSTGRES_USER=clearledger
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=clearledger
POSTGRES_PORT=5432
# If host port 5432 is occupied, use 5433 here and in both Windows URLs below.
# Keep credentials/port aligned with the values above; URL-encode special characters.
# Explicit IPv4 localhost matches Compose's 127.0.0.1 binding and avoids IPv6 retries.
DATABASE_URL=postgresql+psycopg://clearledger:replace-with-local-password@127.0.0.1:5432/clearledger
# Optional: role must have CREATEDB; tests create their own unique database.
TEST_DATABASE_URL=postgresql+psycopg://clearledger:replace-with-local-password@127.0.0.1:5432/clearledger
# When an API runs inside the same Compose network, its DATABASE_URL must instead
# use db:5432 (the service name/internal port), with the same local credentials.
# The current Compose file runs only PostgreSQL; the backend runs on Windows.
# Business APIs require your company UUID and explicit organization provisioning.
# Set this before running python -m clearledger.cli init-organization --name ...
# ORGANIZATION_ID=<your-company-uuid>
# Optional bounded matching configuration (JSON); defaults shown, no credentials.
# MATCHING_LIMITS={"max_candidates":32,"max_combination_size":8,"max_work":100000,"max_time_ms":100,"top_k":20}

# Separate local document interface. Use a randomly generated token (at least 32 characters).
DOCUMENT_ROOT=local-data/documents
# DOCUMENT_API_TOKEN=<generate-locally-do-not-commit>
# External model calls stay disabled unless explicitly configured AND requested for approved synthetic data.
EXTRACTION_PROVIDER=disabled
EXTERNAL_AI_ENABLED=false
# GEMINI_API_KEY=<local-secret-only>
# GEMINI_MODEL=<currently-supported-model-id>
# PRIVACY_REVIEW_REFERENCE=<synthetic-data-privacy-and-provider-review-reference>
LLM_TIMEOUT_MS=10000
LLM_ATTEMPTS=2
LLM_REQUESTS_PER_MINUTE=10
# Optional operator-reviewed INR paise estimates; absent means unknown, never zero cost.
# LLM_INPUT_PAISE_PER_MILLION_TOKENS=<nonnegative-integer>
# LLM_OUTPUT_PAISE_PER_MILLION_TOKENS=<nonnegative-integer>
